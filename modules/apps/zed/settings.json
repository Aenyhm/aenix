{
  "theme": "AeTheme Dark",
  "base_keymap": "SublimeText",
  "disable_ai": true,
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "restore_on_startup": "last_workspace",
  "session": {
    "trust_all_worktrees": true
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "buffer_font_fallbacks": [
    ".ZedMono"
  ],
  "buffer_font_size": 16.0,
  "buffer_font_weight": 100,
  "ui_font_size": 16.0,
  "terminal": {
    "font_size": 16.0
  },
  "cursor_blink": false,
  "tab_size": 4,
  "preferred_line_length": 100,
  "wrap_guides": [
    100
  ],
  "show_wrap_guides": true,
  "soft_wrap": "editor_width",
  "format_on_save": "off",
  "indent_guides": {
    "enabled": false
  },
  "gutter": {
    "folds": false
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "scrollbar": {
    "diagnostics": "error",
    "show": "auto"
  },
  "toolbar": {
    "agent_review": false,
    "breadcrumbs": false,
    "quick_actions": false
  },
  "debugger": {
    "log_dap_communications": false
  },
  "show_call_status_icon": false,
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "outline_panel": {
    "dock": "left",
    "button": false
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "agent": {
    "dock": "right",
    "button": false
  },
  "file_types": {
    "C": [
      "c",
      "keymap"
    ],
    "HTML": [
      "html",
      "jinja"
    ]
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "tab_size": 2
    },
    "Python": {
      "language_servers": ["ty", "!basedpyright", "ruff"],
      "tab_size": 4
    },
    "Vue.js": {
      "enable_language_server": true,
      "tab_size": 2
    },
    "TypeScript": {
      "enable_language_server": true,
      "tab_size": 2
    }
  }
}
