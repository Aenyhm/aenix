{
  # Keys stay in ~/.ssh, copied or generated by hand on each install. The agent started by
  # the system keeps them unlocked for the session, ksshaskpass (set by Plasma) asks the passphrase.
  # Two GitHub accounts: github.com goes to the work one, the github-aenyhm alias to the personal one
  flake.modules.homeManager.apps = {
    programs.ssh = {
      enable = true;
      enableDefaultConfig = false;
      settings = {
        "*".addKeysToAgent = "yes";
        "github.com" = {
          identityFile = "~/.ssh/id_ed25519";
          identitiesOnly = true;
        };
        "github-aenyhm" = {
          hostname = "github.com";
          user = "git";
          identityFile = "~/.ssh/id_ed25519_aenyhm";
          identitiesOnly = true;
        };
      };
    };
  };
}
