{ config, ... }:
{
  # Keys stay in ~/.ssh, copied or generated by hand on each install. The agent started by
  # the system keeps them unlocked for the session, the askpass program of the desktop asks the passphrase.
  # Each session logs in to GitHub with its default key. The github-aenyhm alias, through which every
  # build fetches aenix-private, takes the personal one: the default key outside the work session
  flake.modules.homeManager.apps.imports = [ config.flake.modules.homeManager.ssh ];

  flake.modules.homeManager.ssh = { lib, ... }: {
    programs.ssh = {
      enable = true;
      enableDefaultConfig = false;
      settings = {
        "*".addKeysToAgent = "yes";
        "github.com" = {
          identityFile = "~/.ssh/id_ed25519";
          identitiesOnly = true;
        };
        "github-aenyhm" = {
          hostname = "github.com";
          user = "git";
          identityFile = lib.mkDefault "~/.ssh/id_ed25519";
          identitiesOnly = true;
        };
      };
    };
  };
}
